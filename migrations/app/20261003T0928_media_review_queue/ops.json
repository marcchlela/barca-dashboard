      {
        "description": "create table \"media_review_candidate\"",
        "sql": "CREATE TABLE \"public\".\"media_review_candidate\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"dataSourceId\" uuid NOT NULL,\n  \"durationSeconds\" int4,\n  \"embeddable\" bool DEFAULT true NOT NULL,\n  \"externalMediaId\" text NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"lastSeenAt\" timestamptz NOT NULL,\n  \"matchId\" uuid NOT NULL,\n  \"publishedAt\" timestamptz,\n  \"reasons\" json NOT NULL,\n  \"reviewNote\" text,\n  \"reviewedAt\" timestamptz,\n  \"score\" int4 NOT NULL,\n  \"seasonId\" uuid NOT NULL,\n  \"status\" text DEFAULT 'pending' NOT NULL,\n  \"thumbnailUrl\" text,\n  \"title\" text NOT NULL,\n  \"type\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"url\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"media_review_candidate_status_check_19a2b525\" CHECK (\"status\" IN ('pending', 'approved', 'rejected')),\n  CONSTRAINT \"media_review_candidate_type_check_0b2bf1f8\" CHECK (\"type\" IN ('match_highlight', 'goal_clip', 'interview', 'press_conference', 'training', 'historical', 'other'))\n)",
        "params": []
